rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المستخدمون: كل مستخدم يقدر يشوف بياناته فقط، ويعدلها هو بس
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // الرحلات: الزبون أو الكابتن المرتبط بالرحلة بس يقدر يعدلها
    match /rides/{rideId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid;

      allow update: if request.auth != null && (
                      resource.data.customerId == request.auth.uid ||
                      resource.data.captainId == request.auth.uid ||
                      (resource.data.captainId == null &&
                       request.resource.data.captainId == request.auth.uid)
                    );

      allow delete: if false;
    }
  }
}
